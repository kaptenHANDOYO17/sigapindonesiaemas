# ===========================================================================
#  SIGAP DRAINASE — Contoh Berkas Konfigurasi
#  Salin berkas ini menjadi ".env" lalu isi nilainya.
#      Windows PowerShell : Copy-Item .env.example .env
#      Linux / macOS      : cp .env.example .env
#  JANGAN unggah berkas .env ke GitHub. Sudah dicegah lewat .gitignore.
# ===========================================================================

# --- SUPABASE --------------------------------------------------------------
# Supabase -> Project Settings -> API
# WAJIB memakai kunci "service_role", bukan "anon", karena skrip perlu
# menulis data dan membaca daftar kontak warga.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...ganti_dengan_service_role_key

# --- VEGA INVENTORY SYSTEM (sensor radar) ----------------------------------
# VEGAPULS Air 23 mengirim datanya sendiri ke VEGA Inventory System.
# Token dan ID perangkat didapat dari akun VIS Anda.
# Alamat dasar API dapat berbeda menurut wilayah langganan; periksa di
# dokumentasi akun Anda lalu sesuaikan.
VEGA_BASE_URL=https://vis.vega.com/api/v1
VEGA_API_TOKEN=
VEGA_DEVICE_ID=

# --- TELEGRAM --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID Anda sendiri, untuk menerima laporan bila sistem bermasalah.
# Cari lewat @userinfobot di Telegram.
TELEGRAM_ADMIN_CHAT_ID=

# --- WHATSAPP BUSINESS CLOUD API (opsional) --------------------------------
# Boleh dikosongkan. Bila kosong, notifikasi berjalan lewat Telegram saja.
# Baca docs/PANDUAN_WHATSAPP.md sebelum mengisi bagian ini.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_WARGA=sigap_peringatan_warga
WHATSAPP_TEMPLATE_BPBD=sigap_laporan_bpbd

# --- IDENTITAS SALURAN -----------------------------------------------------
SALURAN_ID=MGH-01
SALURAN_NAMA=Drainase Mangunharjo RT 06 / RW 02
SALURAN_LAT=-6.9575
SALURAN_LON=110.3160

# --- GEOMETRI SALURAN (WAJIB DIUKUR LANGSUNG) ------------------------------
# Tanpa angka yang benar di bawah ini, seluruh sistem menghasilkan angka
# yang salah. Cara mengukurnya ada di docs/KALIBRASI.md bagian 1.
#
# Jarak dari muka sensor ke dasar saluran saat baru dikeruk (mm)
TINGGI_PASANG_MM=1200
# Lebar dasar saluran (mm)
LEBAR_SALURAN_MM=600
# Kedalaman saluran dari dasar ke bibir atas (mm)
KEDALAMAN_SALURAN_MM=800
# Panjang segmen saluran yang diwakili satu sensor (meter)
PANJANG_SEGMEN_M=50
# Debit saat saluran bersih pada hujan sedang (liter per menit)
DEBIT_RANCANGAN_LPM=900

# --- AMBANG BATAS STATUS ---------------------------------------------------
# WAJIB dikalibrasi ulang setelah tiga bulan pengamatan. Baca docs/KALIBRASI.md
AMBANG_ENDAPAN_TINGGI=0.30
AMBANG_ENDAPAN_SANGAT_TINGGI=0.55
AMBANG_DEBIT_MENURUN=0.60
AMBANG_DEBIT_SANGAT_RENDAH=0.30
AMBANG_AIR_MELUAP=0.85
AMBANG_LAJU_NAIK=8.0
AMBANG_PH_MIN=6.0
AMBANG_PH_MAX=8.5
# Nilai ini hanya dipakai bila model anomali belum dilatih. Setelah dilatih,
# sistem memakai ambang dari metadata pelatihan.
AMBANG_ANOMALI=-0.05

# --- PERILAKU SISTEM -------------------------------------------------------
JAM_RAMALAN=12
MENIT_RIWAYAT=720
# Jarak minimal antar peringatan massal, supaya warga tidak dibanjiri pesan.
JEDA_NOTIFIKASI_JAM=4
SITUS_URL=https://sigap-drainase.vercel.app
DRY_RUN=false

# --- PENGUNDUH DATASET ACUAN (hanya perlu saat melatih) --------------------
ROBOFLOW_API_KEY=
