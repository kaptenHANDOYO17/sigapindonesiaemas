# ===========================================================================
#  SIGAP DRAINASE — Konfigurasi Situs
#  Salin menjadi ".env.local" untuk menjalankan di komputer sendiri.
#  Di Vercel, isi seluruhnya pada Settings -> Environment Variables.
# ===========================================================================

# --- Dibaca peramban (boleh dilihat umum) ----------------------------------
# Supabase -> Project Settings -> API
# WAJIB kunci "anon", BUKAN "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...ganti_dengan_anon_key

# Nama pengguna bot Telegram, tanpa tanda @
NEXT_PUBLIC_TELEGRAM_BOT=NAMA_BOT_ANDA

# --- Hanya dibaca server (RAHASIA) -----------------------------------------
# Perhatikan: TIDAK memakai awalan NEXT_PUBLIC_. Awalan itu akan menyisipkan
# nilainya ke berkas yang diunduh peramban, dan seluruh nomor warga terbuka.

# Kunci service_role dari Supabase. Dipakai Route Handler untuk menyimpan
# pendaftaran dan laporan warga tanpa membuka tabel kontak kepada publik.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...ganti_dengan_service_role_key

# Token bot dari @BotFather. Dipakai webhook bot dan pengiriman notifikasi uji.
TELEGRAM_BOT_TOKEN=1234567890:AAG...ganti_dengan_token_bot

# Chat ID pengelola, untuk pemberitahuan saat ada laporan warga baru.
# Dapatkan dengan mengirim pesan apa saja ke @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=123456789

# Kata sandi acak untuk memastikan permintaan webhook benar dari Telegram.
# Buat sendiri, lalu pakai nilai yang sama saat memasang webhook.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=ganti_dengan_kata_sandi_acak

# ===========================================================================
#  CATATAN: ADMIN_TOKEN sudah TIDAK dipakai lagi.
#  Halaman pengelola kini memakai Supabase Auth, sehingga setiap orang punya
#  akun sendiri dan jejaknya dapat ditelusuri. Lihat database/akun_pengelola.sql.
# ===========================================================================
